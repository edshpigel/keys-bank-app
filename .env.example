# ── Public (build-time) ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://new.keys-bank.com/api
NEXT_PUBLIC_BFF_BASE_URL=/api
NEXT_PUBLIC_APP_URL=https://app.keys-bank.com
# Bot @username without @ — for Telegram Mini App deep links
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ── Server-only ─────────────────────────────────────────────────────
# Same token as backend TELEGRAM_BOT_TOKEN (init_data validation is on API;
# keep here for ops reference / future server-side checks).
TELEGRAM_BOT_TOKEN=

# ── Local dev ───────────────────────────────────────────────────────
PORT=3020

# Desktop/browser preview: append ?kb_browser=1 to any URL (skips PWA install gate)
